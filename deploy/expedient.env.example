# Copiar a /etc/expedient.env (permisos 600). Valores de ejemplo, no reales.
PORT=4875
APP_PUBLIC_URL=https://expedient.empresa.example
APP_BIND=127.0.0.1
APP_AUTH=local
APP_DATA_PATH=/var/lib/expedient/expedient.db
APP_USERS_PATH=/var/lib/expedient/users.json
# Correo (solo lectura). Rellenar al instalar en destino con el registro de app de Entra de la empresa:
# GRAPH_ENABLED=true
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MAIL_INTAKE_ENABLED=true
# MAIL_INTAKE_APPROVED=true
# MAIL_FOLDER_ID=
# MAIL_SENT_FOLDER_ID=
# OWN_MAIL_DOMAINS=empresa.example
# MAIL_START_AFTER=2026-01-01T00:00:00Z
# IA opcional, apagada por defecto:
# AI_PROPOSER_ENABLED=false
