{
  "name": "expedient-local-demo",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:html": "node build.mjs",
    "demo": "node --env-file-if-exists=.env server/server.mjs",
    "demo:simulated": "node --env-file=simulation.env server/server.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "adduser": "node scripts/adduser.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "7.2.3",
    "exceljs": "4.4.0",
    "pdfjs-dist": "6.5.438"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
