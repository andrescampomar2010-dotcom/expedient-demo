# No credentials supplied. Do not commit a real .env file.
GRAPH_ENABLED=false
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:4875/auth/callback
PORT=4875

# Optional Claude API: leave disabled until data and cost approval.
CLAUDE_ENABLED=false
CLAUDE_DATA_APPROVED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_MAX_OUTPUT_TOKENS=600
# Simulation never calls external providers. Cannot combine with live flags.
INTEGRATION_MOCK=false
APP_DATA_PATH=data/workspace.json

# Real automatic mailbox receiver. Never enabled by the demonstration.
MAIL_INTAKE_ENABLED=false
MAIL_INTAKE_APPROVED=false
MAIL_FOLDER_ID=
MAIL_START_AFTER=
MAIL_POLL_MINUTES=60

# Chat con asistente integrado (docs/CHAT.md). Reglas locales siempre disponibles.
# Modelos de IA opcionales, elegibles por persona. Cobertura exacta: solo los proveedores
# con adaptador (anthropic, openai compatible, gemini) y los modelos listados aquí.
# Lista: proveedor:modelo separados por comas. Requiere CHAT_DATA_APPROVED=true y la clave del proveedor.
CHAT_MODELS=
CHAT_DATA_APPROVED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Envío autónomo de respuestas desde el chat. Apagado por defecto. Exige además:
# cuenta Graph configurada y autorizada (scope Mail.Send), política por persona concedida
# por un admin (dominios, propósito, tope diario, revocable). Confirmación explícita por envío,
# salvo que la política lleve auto:true (autonomía real dentro del alcance, apagada por defecto).
MAIL_SEND_ENABLED=false

# Conservación de binarios de adjuntos al preparar expedientes desde el chat. Apagada por
# defecto; exige además una fuente autorizada configurada en el servidor. Topes duros en
# server/chat.mjs: 5 MB por archivo, 40 MB y 200 archivos en total.
CHAT_ATTACH_STORE=false
CHAT_ATTACH_DIR=
MAIL_SEND_APPROVED=false
